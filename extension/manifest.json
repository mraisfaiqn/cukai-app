{
  "manifest_version": 3,
  "name": "Cukai Tax Assistant",
  "version": "0.2.0",
  "description": "Ask CukaiBot your Malaysian tax questions and copy your Form B figures from any page — including the LHDN e-Filing portal.",
  "action": {
    "default_title": "Open Cukai Tax Assistant"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "https://cukai-my.web.app/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["floating-button.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/cukai-logo.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/cukai-logo.png",
    "48": "icons/cukai-logo.png",
    "128": "icons/cukai-logo.png"
  }
}