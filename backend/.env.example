# Copy to .env and fill in. database.py loads this automatically.

# Local / self-hosted Postgres (driver+driver-name format SQLAlchemy expects):
DATABASE_URL=postgresql+pg8000://USER:PASSWORD@HOST:5432/cukai

# Production: Google Cloud SQL via the connector (overrides DATABASE_URL when set)
# INSTANCE_CONNECTION_NAME=project:region:instance
# DB_USER=
# DB_PASS=
# DB_NAME=
# DB_PRIVATE_IP=        # set to any value to use a private IP
